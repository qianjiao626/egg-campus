generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum EggRarity {
  N
  R
  SR
  SSR
  UR
}

model User {
  id              BigInt     @id @default(autoincrement())
  nickname        String     @unique @db.VarChar(50)
  email           String?    @unique @db.VarChar(100)
  phone           String?    @unique @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  role            UserRole   @default(student)
  status          UserStatus @default(active)
  school          String?    @db.VarChar(100)
  major           String?    @db.VarChar(100)
  city            String?    @db.VarChar(50)
  grade           String?    @db.VarChar(20)
  age             Int?
  bio             String?    @db.Text
  mbtiType        String?    @map("mbti_type") @db.VarChar(4)
  mbtiGroup       String?    @map("mbti_group") @db.VarChar(2)
  likes           Int        @default(0)
  reputation      Decimal    @default(0) @db.Decimal(3, 2)
  eggCategory     String?    @map("egg_category") @db.VarChar(20)
  eggRarity       EggRarity  @default(N) @map("egg_rarity")
  inviteCode      String?    @unique @map("invite_code") @db.VarChar(20)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  verifiedPhoneAt DateTime?  @map("verified_phone_at")
  verifiedEmailAt DateTime?  @map("verified_email_at")
  nicknameChangedAt DateTime? @map("nickname_changed_at")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  protectedAdminKey String?   @unique @map("protected_admin_key") @db.VarChar(40)
  interests        Json?
  skills           Json?

  account                     PointAccount?
  characters                  UserCharacter[]
  sessions                    AuthSession[]
  stats                       UserStats?
  transactions                PointTransaction[]
  buddyPreference             BuddyPreference?
  buddyBoxesCreated           BuddyBox[]           @relation("BuddyBoxCreator")
  buddyMessagesSent           BuddyMessage[]       @relation("BuddyMessageSender")
  buddyMessagesReceived       BuddyMessage[]       @relation("BuddyMessageRecipient")
  buddyFriendRequestsSent     BuddyFriendRequest[] @relation("BuddyFriendRequester")
  buddyFriendRequestsReceived BuddyFriendRequest[] @relation("BuddyFriendRecipient")
  buddyFeatureRecords         BuddyFeatureRecord[]
  tasks                       Task[]
  feedbacks                   Feedback[]
  inquiries                   Inquiry[]
  inquiryReplies              InquiryReply[]
  inquiryLikes                InquiryLike[]
  inquiryReplyLikes           InquiryReplyLike[]
  notifications               Notification[]
   taskClaims                  TaskClaim[]          @relation("TaskClaimer")
   taskCancellationRequestsMade     TaskCancellationRequest[] @relation("TaskCancellationRequester")
   taskCancellationRequestsReceived TaskCancellationRequest[] @relation("TaskCancellationRecipient")
  ratingsGiven                Rating[]             @relation("RatingFromUser")
  ratingsReceived             Rating[]             @relation("RatingToUser")
  roleGrants                  UserRoleGrant[]       @relation("RoleGrantUser")
  roleGrantsIssued            UserRoleGrant[]       @relation("RoleGrantGrantor")
  roleGrantsRevoked           UserRoleGrant[]       @relation("RoleGrantRevoker")
  roleGrantAudits             RoleGrantAudit[]
  feedbackMessages            FeedbackMessage[]
  feedbackAttachmentsUploaded FeedbackAttachment[] @relation("FeedbackAttachmentUploader")
  feedbackAttachmentsHidden   FeedbackAttachment[] @relation("FeedbackAttachmentHider")
  resourceReadStates          ResourceReadState[]
  shopProducts                ShopProduct[]        @relation("ShopProductPublisher")
  shopCartItems               ShopCartItem[]
  shopOrders                  ShopOrder[]
  shippingAddresses           ShippingAddress[]
  shopEntitlements            UserEntitlement[]
  shopReviews                 ProductReview[]
  invitationsSent             Invitation[]        @relation("InvitationInviter")
  invitationReceived          Invitation?         @relation("InvitationInvitee")
  blacklistComments           BlacklistComment[]
  adminAvatarSettingsUpdated  AdminAvatarSetting[] @relation("AdminAvatarSettingUpdater")

  @@map("users")
}

enum BlacklistCommentStatus {
  approved
  deleted
}

model BlacklistSchool {
  id        BigInt            @id @default(autoincrement())
  name      String            @unique @db.VarChar(200)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  comments  BlacklistComment[]

  @@index([name])
  @@map("schools")
}

model AdminAvatarSetting {
  id         BigInt   @id @default(autoincrement())
  singleton  String   @unique @default("default") @db.VarChar(20)
  assetPath  String   @map("asset_path") @db.VarChar(160)
  updatedBy  BigInt   @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  updater User @relation("AdminAvatarSettingUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("admin_avatar_settings")
}

model BlacklistComment {
  id            BigInt                 @id @default(autoincrement())
  userId        BigInt                 @map("user_id")
  schoolId      BigInt                 @map("school_id")
  content       String?                @db.Text
  averageScore  Decimal                @map("average_score") @db.Decimal(3, 1)
  status        BlacklistCommentStatus @default(approved)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        BlacklistSchool        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores        BlacklistScore[]

  @@unique([userId, schoolId])
  @@index([schoolId, status, createdAt])
  @@map("school_comments")
}

model BlacklistScore {
  id        BigInt           @id @default(autoincrement())
  commentId BigInt           @map("comment_id")
  metricKey String           @map("metric_key") @db.VarChar(40)
  score     Int
  createdAt DateTime         @default(now()) @map("created_at")
  comment   BlacklistComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, metricKey])
  @@index([metricKey, score])
  @@map("school_scores")
}

model AuthSession {
  id               String    @id @default(cuid()) @db.VarChar(30)
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ip               String?   @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model VerificationCode {
  id                    String    @id @default(cuid()) @db.VarChar(30)
  channel               String    @db.VarChar(10)
  target                String    @db.VarChar(100)
  purpose               String    @db.VarChar(30)
  codeHash              String    @map("code_hash") @db.VarChar(64)
  verificationTokenHash String?   @unique @map("verification_token_hash") @db.VarChar(64)
  attempts              Int       @default(0)
  maxAttempts           Int       @default(5) @map("max_attempts")
  expiresAt             DateTime  @map("expires_at")
  verifiedAt            DateTime? @map("verified_at")
  consumedAt            DateTime? @map("consumed_at")
  requestIp             String?   @map("request_ip") @db.VarChar(45)
  userAgent             String?   @map("user_agent") @db.VarChar(512)
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
  @@map("verification_codes")
}

model UserStats {
  userId         BigInt   @id @map("user_id")
  knowledge      Decimal  @default(0) @db.Decimal(3, 1)
  skills         Decimal  @default(0) @db.Decimal(3, 1)
  charm          Decimal  @default(0) @db.Decimal(3, 1)
  money          Decimal  @default(0) @db.Decimal(3, 1)
  reputation     Decimal  @default(0) @db.Decimal(3, 2)
  completedTasks Int      @default(0) @map("completed_tasks")
  publishedTasks Int      @default(0) @map("published_tasks")
  experience     Int      @default(0)
  dailyPublishDate DateTime? @map("daily_publish_date")
  dailyPublishCount Int    @default(0) @map("daily_publish_count")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model UserCharacter {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  category   String    @db.VarChar(20)
  unlocked   Boolean   @default(false)
  count      Int       @default(0)
  isCurrent  Boolean   @default(false) @map("is_current")
  unlockedAt DateTime? @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("user_characters")
}

model PointAccount {
  userId           BigInt   @id @map("user_id")
  availableBalance Int      @default(100) @map("available_balance")
  frozenBalance    Int      @default(0) @map("frozen_balance")
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_accounts")
}

model PointTransaction {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  type             String   @db.VarChar(50)
  deltaAvailable   Int      @map("delta_available")
  deltaFrozen      Int      @map("delta_frozen")
  balanceAvailable Int      @map("balance_available")
  balanceFrozen    Int      @map("balance_frozen")
  taskId           BigInt?  @map("task_id")
  idempotencyKey   String   @unique @map("idempotency_key") @db.VarChar(100)
  operatorId       BigInt?  @map("operator_id")
  remark           String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([taskId])
  @@map("point_transactions")
}

model Invitation {
  id             BigInt    @id @default(autoincrement())
  inviterId      BigInt    @map("inviter_id")
  invitedUserId  BigInt    @unique @map("invited_user_id")
  inviteCode     String    @map("invite_code") @db.VarChar(20)
  rewardedAt     DateTime? @map("rewarded_at")
  rewardedTaskId BigInt?   @map("rewarded_task_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  inviter     User @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitedUser User @relation("InvitationInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@index([inviterId, createdAt])
  @@index([rewardedAt, createdAt])
  @@map("invitations")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String   @map("target_id") @db.VarChar(100)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Role {
  id              BigInt   @id @default(autoincrement())
  code            String   @unique @db.VarChar(80)
  name            String   @db.VarChar(80)
  description     String?  @db.VarChar(500)
  enabled         Boolean  @default(true)
  systemProtected Boolean  @default(false) @map("system_protected")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  grants      UserRoleGrant[]

  @@index([enabled, createdAt])
  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(80)
  description String   @db.VarChar(500)
  risk        String   @default("normal") @db.VarChar(20)
  protected   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       BigInt   @map("role_id")
  permissionId BigInt   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleGrant {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  roleId       BigInt    @map("role_id")
  grantedBy    BigInt?   @map("granted_by")
  startsAt     DateTime  @default(now()) @map("starts_at")
  expiresAt    DateTime? @map("expires_at")
  isPermanent  Boolean   @default(false) @map("is_permanent")
  revokedAt    DateTime? @map("revoked_at")
  revokedBy    BigInt?   @map("revoked_by")
  revokeReason String?   @map("revoke_reason") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user          User             @relation("RoleGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  role          Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedByUser User?            @relation("RoleGrantGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)
  revokedByUser User?            @relation("RoleGrantRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)
  audits        RoleGrantAudit[]

  @@index([userId, revokedAt, startsAt, expiresAt])
  @@index([roleId, revokedAt])
  @@index([grantedBy])
  @@index([revokedBy])
  @@map("user_role_grants")
}

model RoleGrantAudit {
  id         BigInt    @id @default(autoincrement())
  grantId    BigInt?   @map("grant_id")
  actorId    BigInt?   @map("actor_id")
  action     String    @db.VarChar(40)
  beforeData Json?     @map("before_data")
  afterData  Json?     @map("after_data")
  reason     String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")

  grant UserRoleGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  actor User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([grantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("role_grant_audits")
}

model BuddyPreference {
  userId       BigInt   @id @map("user_id")
  mbtiType     String?  @map("mbti_type") @db.VarChar(4)
  hobbies      Json
  todayActions Json     @map("today_actions")
  province     String?  @db.VarChar(50)
  city         String?  @db.VarChar(50)
  district     String?  @db.VarChar(50)
  stealth      Boolean  @default(false)
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buddy_preferences")
}

model BuddyBox {
  id        BigInt   @id @default(autoincrement())
  creatorId BigInt   @map("creator_id")
  kind      String   @db.VarChar(30)
  payload   Json
  status    String   @default("open") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  creator   User     @relation("BuddyBoxCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
  @@map("buddy_boxes")
}

model BuddyMessage {
  id          BigInt    @id @default(autoincrement())
  senderId    BigInt    @map("sender_id")
  recipientId BigInt    @map("recipient_id")
  text        String    @db.VarChar(180)
  source      String?   @db.VarChar(30)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  sender      User      @relation("BuddyMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("BuddyMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@map("buddy_messages")
}

model BuddyFriendRequest {
  id          BigInt   @id @default(autoincrement())
  requesterId BigInt   @map("requester_id")
  recipientId BigInt   @map("recipient_id")
  status      String   @default("pending") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  requester   User     @relation("BuddyFriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User     @relation("BuddyFriendRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
  @@map("buddy_friend_requests")
}

model Task {
  id           BigInt      @id @default(autoincrement())
  userId       BigInt      @map("user_id")
  title        String      @db.VarChar(160)
  description  String      @db.Text
  remark       String?     @db.Text
  taskType     String      @default("teach") @map("task_type") @db.VarChar(20)
  claimMode    String      @default("single") @map("claim_mode") @db.VarChar(20)
  reward       Int         @default(0)
  publishExpReward Int     @default(0) @map("publish_exp_reward")
  maxClaimers  Int         @default(1) @map("max_claimers")
  contact      String?     @db.VarChar(160)
  requirements String?     @db.Text
  skillCategory String?     @map("skill_category") @db.VarChar(50)
  skillSubcategory String?  @map("skill_subcategory") @db.VarChar(50)
  status       String      @default("pending_review") @db.VarChar(30)
  reviewReason String?     @map("review_reason") @db.VarChar(500)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  reviewedAt   DateTime?   @map("reviewed_at")
  completedAt  DateTime?   @map("completed_at")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
   claims       TaskClaim[]
   cancellationRequests TaskCancellationRequest[]
   ratings      Rating[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@map("tasks")
}

 model TaskClaim {
  id           BigInt    @id @default(autoincrement())
  taskId       BigInt    @map("task_id")
  claimerId    BigInt    @map("claimer_id")
  contact      String?   @db.VarChar(160)
  status       String    @default("pending") @db.VarChar(20)
  frozenAmount Int       @default(0) @map("frozen_amount")
  submittedAt  DateTime? @map("submitted_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  claimer      User      @relation("TaskClaimer", fields: [claimerId], references: [id], onDelete: Cascade)

  @@unique([taskId, claimerId])
  @@index([taskId, status])
  @@index([claimerId, status, createdAt])
  @@map("task_claims")
 }

model TaskCancellationRequest {
  id          BigInt    @id @default(autoincrement())
  taskId      BigInt    @map("task_id")
  requesterId BigInt    @map("requester_id")
  recipientId BigInt    @map("recipient_id")
  reason      String    @db.VarChar(500)
  status      String    @default("pending") @db.VarChar(20)
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requester User @relation("TaskCancellationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("TaskCancellationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([taskId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([recipientId, status, createdAt])
  @@map("task_cancellation_requests")
}

model Rating {
  id         BigInt   @id @default(autoincrement())
  taskId     BigInt   @map("task_id")
  fromUserId BigInt   @map("from_user_id")
  toUserId   BigInt   @map("to_user_id")
  score      Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUser   User     @relation("RatingFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("RatingToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([taskId, fromUserId, toUserId])
  @@index([toUserId, createdAt])
  @@map("ratings")
}

model Feedback {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  type        String   @db.VarChar(50)
  content     String   @db.Text
  contact     String?  @db.VarChar(160)
  source      String?  @db.VarChar(100)
  status      String   @default("open") @db.VarChar(20)
  adminRemark String?  @map("admin_remark") @db.Text
  closedAt    DateTime? @map("closed_at")
  reopenedAt  DateTime? @map("reopened_at")
  reopenCount Int       @default(0) @map("reopen_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    FeedbackMessage[]
  attachments FeedbackAttachment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("feedback")
}

model FeedbackMessage {
  id         BigInt   @id @default(autoincrement())
  feedbackId BigInt   @map("feedback_id")
  authorId   BigInt?  @map("author_id")
  authorType String   @map("author_type") @db.VarChar(20)
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  feedback   Feedback             @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author     User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments FeedbackAttachment[]

  @@index([feedbackId, createdAt])
  @@index([authorId, createdAt])
  @@map("feedback_messages")
}

model FeedbackAttachment {
  id           BigInt    @id @default(autoincrement())
  feedbackId   BigInt    @map("feedback_id")
  messageId    BigInt?   @map("message_id")
  uploaderId   BigInt    @map("uploader_id")
  storageKey   String    @unique @map("storage_key") @db.VarChar(120)
  originalName String    @map("original_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(80)
  sizeBytes    Int       @map("size_bytes")
  hiddenAt     DateTime? @map("hidden_at")
  hiddenBy     BigInt?   @map("hidden_by")
  hiddenReason String?   @map("hidden_reason") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")

  feedback     Feedback         @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  message      FeedbackMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader     User             @relation("FeedbackAttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  hiddenByUser User?            @relation("FeedbackAttachmentHider", fields: [hiddenBy], references: [id], onDelete: SetNull)

  @@index([feedbackId, createdAt])
  @@index([messageId])
  @@index([uploaderId])
  @@index([hiddenBy])
  @@map("feedback_attachments")
}

model ResourceReadState {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  resourceType  String   @map("resource_type") @db.VarChar(40)
  resourceId    String   @map("resource_id") @db.VarChar(100)
  lastMessageId BigInt?  @map("last_message_id")
  lastReadAt    DateTime @default(now()) @map("last_read_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([userId, resourceType, lastReadAt])
  @@map("resource_read_states")
}

model Inquiry {
  id         BigInt         @id @default(autoincrement())
  userId     BigInt         @map("user_id")
  title      String         @db.VarChar(160)
  content    String         @db.Text
  tags       Json
  bounty     Int            @default(0)
  status     String         @default("open") @db.VarChar(20)
  coinStatus String         @default("open") @map("coin_status") @db.VarChar(20)
  likes      Int            @default(0)
  adopted    Boolean        @default(false)
  adoptedReplyId BigInt?    @map("adopted_reply_id")
  deadline   DateTime?
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies    InquiryReply[]
  likesBy    InquiryLike[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("inquiries")
}

model InquiryReply {
  id        BigInt   @id @default(autoincrement())
  inquiryId BigInt   @map("inquiry_id")
  userId    BigInt   @map("user_id")
  content   String   @db.Text
  kind      String   @default("answer") @db.VarChar(20)
  parentId  BigInt?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      InquiryReplyLike[]

  @@index([inquiryId, createdAt])
  @@map("inquiry_replies")
}

model InquiryLike {
  id        BigInt   @id @default(autoincrement())
  inquiryId BigInt   @map("inquiry_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, userId])
  @@index([userId, createdAt])
  @@index([userId, inquiryId])
  @@map("inquiry_likes")
}

model InquiryReplyLike {
  id        BigInt        @id @default(autoincrement())
  replyId   BigInt        @map("reply_id")
  userId    BigInt        @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  reply     InquiryReply  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([userId, createdAt])
  @@map("inquiry_reply_likes")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  type      String    @db.VarChar(40)
  refId     String?   @map("ref_id") @db.VarChar(100)
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum ShopProductType {
  virtual
  physical
}

enum ShopProductStatus {
  draft
  pending_review
  rejected
  approved
  on_sale
  off_sale
  archived
  sold_out
}

enum ShopOrderStatus {
  paid
  awaiting_shipment
  shipped
  completed
  cancel_requested
  cancelled
  refunding
  refunded
  failed
}

enum ShopRedeemCodeStatus {
  available
  assigned
  used
  disabled
}

enum ShopEntitlementStatus {
  active
  used
  expired
  revoked
}

model ShopProduct {
  id                BigInt            @id @default(autoincrement())
  publisherId       BigInt?           @map("publisher_id")
  publisherNickname String?           @map("publisher_nickname") @db.VarChar(50)
  name              String            @db.VarChar(120)
  type              ShopProductType
  category          String?           @db.VarChar(60)
  summary           String?           @db.VarChar(240)
  description       String            @db.Text
  price             Int
  stock             Int?
  unlimitedStock    Boolean           @default(false) @map("unlimited_stock")
  minQuantity       Int               @default(1) @map("min_quantity")
  maxQuantity       Int               @default(1) @map("max_quantity")
  virtualType       String?           @map("virtual_type") @db.VarChar(60)
  fulfillmentData   Json?             @map("fulfillment_data")
  status            ShopProductStatus @default(draft)
  reviewReason      String?           @map("review_reason") @db.VarChar(500)
  reviewedBy        BigInt?           @map("reviewed_by")
  reviewedAt        DateTime?         @map("reviewed_at")
  publishedAt       DateTime?         @map("published_at")
  archivedAt        DateTime?         @map("archived_at")
  viewCount         Int               @default(0) @map("view_count")
  salesCount        Int               @default(0) @map("sales_count")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  publisher         User?             @relation("ShopProductPublisher", fields: [publisherId], references: [id], onDelete: SetNull)
  images            ShopProductImage[]
  cartItems         ShopCartItem[]
  orderItems        ShopOrderItem[]
  redeemCodes       ProductRedeemCode[]
  entitlements      UserEntitlement[]
  reviews           ProductReview[]

  @@index([status, publishedAt])
  @@index([publisherId, status, createdAt])
  @@index([status, publisherId])
  @@index([category, status])
  @@map("shop_products")
}

model ShopProductImage {
  id         BigInt      @id @default(autoincrement())
  productId  BigInt      @map("product_id")
  url        String      @db.VarChar(500)
  kind       String      @default("detail") @db.VarChar(20)
  sortOrder  Int         @default(0) @map("sort_order")
  deletedAt  DateTime?   @map("deleted_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  product    ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind, sortOrder])
  @@map("shop_product_images")
}

model ShopCartItem {
  id         BigInt      @id @default(autoincrement())
  userId     BigInt      @map("user_id")
  productId  BigInt      @map("product_id")
  quantity   Int         @default(1)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, updatedAt])
  @@map("shop_cart_items")
}

model ShippingAddress {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  recipientName String   @map("recipient_name") @db.VarChar(50)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(50)
  city          String   @db.VarChar(50)
  district      String   @db.VarChar(50)
  detail        String   @db.VarChar(300)
  postalCode    String?  @map("postal_code") @db.VarChar(10)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        ShopOrder[]

  @@index([userId, isDefault])
  @@map("shipping_addresses")
}

model ShopOrder {
  id              BigInt          @id @default(autoincrement())
  userId          BigInt          @map("user_id")
  status          ShopOrderStatus @default(paid)
  totalAmount     Int             @map("total_amount")
  needsShipment   Boolean         @default(false) @map("needs_shipment")
  idempotencyKey  String          @unique @map("idempotency_key") @db.VarChar(100)
  addressId       BigInt?         @map("address_id")
  recipientName   String?         @map("recipient_name") @db.VarChar(50)
  phone           String?         @db.VarChar(20)
  addressSnapshot Json?           @map("address_snapshot")
  carrier         String?         @db.VarChar(60)
  trackingNumber  String?         @map("tracking_number") @db.VarChar(100)
  shippedAt       DateTime?       @map("shipped_at")
  completedAt     DateTime?       @map("completed_at")
  cancelledAt     DateTime?       @map("cancelled_at")
  cancelReason    String?         @map("cancel_reason") @db.VarChar(500)
  refundedAt      DateTime?       @map("refunded_at")
  refundReason    String?         @map("refund_reason") @db.VarChar(500)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  address         ShippingAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items           ShopOrderItem[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, completedAt, shippedAt])
  @@map("shop_orders")
}

model ShopOrderItem {
  id               BigInt           @id @default(autoincrement())
  orderId          BigInt           @map("order_id")
  productId        BigInt           @map("product_id")
  productName      String           @map("product_name") @db.VarChar(120)
  productType      ShopProductType  @map("product_type")
  unitPrice        Int              @map("unit_price")
  quantity         Int
  fulfillmentStatus String          @default("pending") @map("fulfillment_status") @db.VarChar(30)
  fulfillmentData  Json?            @map("fulfillment_data")
  createdAt        DateTime         @default(now()) @map("created_at")
  order            ShopOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          ShopProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  entitlements     UserEntitlement[]
  redeemCodes      ProductRedeemCode[]
  reviews          ProductReview[]

  @@index([orderId])
  @@index([productId, createdAt])
  @@map("shop_order_items")
}

model UserEntitlement {
  id          BigInt              @id @default(autoincrement())
  userId      BigInt              @map("user_id")
  productId   BigInt              @map("product_id")
  orderItemId BigInt              @map("order_item_id")
  type        String              @db.VarChar(60)
  payload     Json
  status      ShopEntitlementStatus @default(active)
  acquiredAt  DateTime            @default(now()) @map("acquired_at")
  expiresAt   DateTime?           @map("expires_at")
  usedAt      DateTime?           @map("used_at")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     ShopProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem   ShopOrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([userId, status, acquiredAt])
  @@index([productId, acquiredAt])
  @@map("user_entitlements")
}

model ProductRedeemCode {
  id           BigInt             @id @default(autoincrement())
  productId    BigInt             @map("product_id")
  orderItemId  BigInt?            @map("order_item_id")
  codeHash     String             @map("code_hash") @db.VarChar(128)
  codeMask     String             @map("code_mask") @db.VarChar(80)
  codeCiphertext String           @map("code_ciphertext") @db.Text
  status       ShopRedeemCodeStatus @default(available)
  assignedAt   DateTime?          @map("assigned_at")
  usedAt       DateTime?          @map("used_at")
  product      ShopProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem    ShopOrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([productId, codeHash])
  @@index([productId, status])
  @@index([orderItemId])
  @@map("product_redeem_codes")
}

model ProductReview {
  id          BigInt      @id @default(autoincrement())
  productId   BigInt      @map("product_id")
  orderItemId BigInt      @map("order_item_id")
  userId      BigInt      @map("user_id")
  rating      Int
  content     String?     @db.Text
  visible     Boolean     @default(true)
  hiddenReason String?    @map("hidden_reason") @db.VarChar(500)
  hiddenAt    DateTime?   @map("hidden_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  product     ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem   ShopOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderItemId])
  @@index([productId, visible, createdAt])
  @@index([userId, createdAt])
  @@map("product_reviews")
}

model BuddyFeatureRecord {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  feature        String   @db.VarChar(40)
  action         String   @db.VarChar(40)
  status         String   @default("active") @db.VarChar(20)
  payload        Json
  result         Json?
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([feature, status, createdAt])
  @@map("buddy_feature_records")
}
