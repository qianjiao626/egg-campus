# MySQL running on the same CVM as the backend.
# Keep MySQL bound to localhost; the backend connects through 127.0.0.1.
DATABASE_URL="mysql://app_user:replace-me@127.0.0.1:3306/dandan_world"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"
VERIFICATION_PROVIDER="disabled"
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
REFRESH_COOKIE_ENABLED=true
COOKIE_SECURE=true
# The Nginx /dd deployment rewrites this upstream path to /dd/api.
# It must cover auth and buddy-box routes so both share one session.
COOKIE_PATH="/api"
COOKIE_DOMAIN=""
FEEDBACK_ATTACHMENT_ROOT="/var/lib/dandan-campus/private/feedback"
SHOP_ENABLED=false
